From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Toolchain Maintainer <maintainer@example.com>
Date: Fri, 28 Aug 2026 14:26:00 +0800
Subject: [PATCH] binutils 2.38: customize x86 opcode mappings for i586-unknown-elf

This patch customizes x86 opcode mappings for the i586-unknown-elf target:
- bfd: update lazy PLT entry to use JUMP_PC_RELATIVE32
- gas: update jump disp8 opcode mapping
- gold: update PLT entry jump opcode
- include/opcode/i386.h: define JUMP_PC_RELATIVE and JUMP_PC_RELATIVE32
- opcodes: update disassembler tables and optab for sub, or, adc, jmp, wrmsr, rdtsc, rdmsr

---
diff --git a/bfd/elf32-i386.c b/bfd/elf32-i386.c
index 25977cc..39c363f 100644
--- a/bfd/elf32-i386.c
+++ b/bfd/elf32-i386.c
@@ -556,7 +556,7 @@ static const bfd_byte elf_i386_lazy_plt_entry[LAZY_PLT_ENTRY_SIZE] =
   0, 0, 0, 0,	/* replaced with address of this symbol in .got.  */
   0x68,		/* pushl immediate */
   0, 0, 0, 0,	/* replaced with offset into relocation table.  */
-  0xe9,		/* jmp relative */
+  JUMP_PC_RELATIVE32,		/* jmp relative */
   0, 0, 0, 0	/* replaced with offset to start of .plt.  */
 };
 
@@ -579,7 +579,7 @@ static const bfd_byte elf_i386_pic_lazy_plt_entry[LAZY_PLT_ENTRY_SIZE] =
   0, 0, 0, 0,	/* replaced with offset of this symbol in .got.  */
   0x68,		/* pushl immediate */
   0, 0, 0, 0,	/* replaced with offset into relocation table.  */
-  0xe9,		/* jmp relative */
+  JUMP_PC_RELATIVE32,		/* jmp relative */
   0, 0, 0, 0	/* replaced with offset to start of .plt.  */
 };
 
@@ -620,7 +620,7 @@ static const bfd_byte elf_i386_lazy_ibt_plt_entry[LAZY_PLT_ENTRY_SIZE] =
 {
   0xf3, 0x0f, 0x1e, 0xfb,	/* endbr32		      */
   0x68, 0, 0, 0, 0,		/* pushl immediate	      */
-  0xe9, 0, 0, 0, 0,		/* jmp relative		      */
+  JUMP_PC_RELATIVE32, 0, 0, 0, 0,		/* jmp relative		      */
   0x66, 0x90			/* xchg %ax,%ax		      */
 };
 
@@ -1350,7 +1350,7 @@ elf_i386_convert_load_reloc (bfd *abfd, Elf_Internal_Shdr *symtab_hdr,
 	  else
 	    {
 	      /* Convert to "jmp foo nop".  */
-	      modrm = 0xe9;
+	      modrm = JUMP_PC_RELATIVE32;
 	      nop = NOP_OPCODE;
 	      nop_offset = roff + 3;
 	      irel->r_offset -= 1;
diff --git a/gas/config/tc-i386.c b/gas/config/tc-i386.c
index e063268..50d8f27 100644
--- a/gas/config/tc-i386.c
+++ b/gas/config/tc-i386.c
@@ -1422,11 +1422,11 @@ static const unsigned char f16_3[] =
