   {0x8d,0xb4,0x00,0x00};		/* lea 0W(%si),%si	*/
 static const unsigned char jump_disp8[] =
-  {0xeb};				/* jmp disp8	       */
+  {JUMP_PC_RELATIVE};				/* jmp disp8	       */
 static const unsigned char jump32_disp32[] =
-  {0xe9};				/* jmp disp32	       */
+  {JUMP_PC_RELATIVE32};				/* jmp disp32	       */
 static const unsigned char jump16_disp32[] =
-  {0x66,0xe9};				/* jmp disp32	       */
+  {0x66,JUMP_PC_RELATIVE32};				/* jmp disp32	       */
 /* 32-bit NOPs patterns.  */
 static const unsigned char *const f32_patt[] = {
   f32_1, f32_2, f32_3, f32_4, NULL, f32_6, f32_7
@@ -12314,7 +12314,7 @@ md_estimate_size_before_relax (fragS *fragP, segT segment)
 	{
 	case UNCOND_JUMP:
 	  /* Make jmp (0xeb) a (d)word displacement jump.  */
-	  opcode[0] = 0xe9;
+	  opcode[0] = JUMP_PC_RELATIVE32;
 	  fragP->fr_fix += size;
 	  fixP = fix_new (fragP, old_fr_fix, size,
 			  fragP->fr_symbol,
@@ -12331,7 +12331,7 @@ md_estimate_size_before_relax (fragS *fragP, segT segment)
 	      opcode[0] ^= 1;
 	      opcode[1] = 3;
 	      /* Insert an unconditional jump.  */
-	      opcode[2] = 0xe9;
+	      opcode[2] = JUMP_PC_RELATIVE32;
 	      /* We added two extra opcode bytes, and have a two byte
 		 offset.  */
 	      fragP->fr_fix += 2 + 2;
@@ -12539,13 +12539,13 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED, segT sec ATTRIBUTE_UNUSED,
 	{
 	case ENCODE_RELAX_STATE (UNCOND_JUMP, BIG):
 	  extension = 4;		/* 1 opcode + 4 displacement  */
-	  opcode[0] = 0xe9;
+	  opcode[0] = JUMP_PC_RELATIVE32;
 	  where_to_put_displacement = &opcode[1];
 	  break;
 
 	case ENCODE_RELAX_STATE (UNCOND_JUMP, BIG16):
 	  extension = 2;		/* 1 opcode + 2 displacement  */
-	  opcode[0] = 0xe9;
+	  opcode[0] = JUMP_PC_RELATIVE32;
 	  where_to_put_displacement = &opcode[1];
 	  break;
 
@@ -12568,7 +12568,7 @@ md_convert_frag (bfd *abfd ATTRIBUTE_UNUSED, segT sec ATTRIBUTE_UNUSED,
 	  extension = 4;
 	  opcode[0] ^= 1;
 	  opcode[1] = 3;
-	  opcode[2] = 0xe9;
+	  opcode[2] = JUMP_PC_RELATIVE32;
 	  where_to_put_displacement = &opcode[3];
 	  break;
 
